<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" styleClass="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml">
    <stylesheets>
        <URL value="@estilo.css"/>
    </stylesheets>
    <Label styleClass="titulo" text="Reservar entrada"/>
    <TextField fx:id="campoEventoId" promptText="Código del evento"/>
    <TextField fx:id="campoEstudianteId" promptText="Código del estudiante"/>
    <Button onAction="#solicitar" styleClass="boton" text="Solicitar reserva"/>
    <TextField fx:id="campoCodigoReserva" promptText="Código de la reserva (para confirmar)"/>
    <Button onAction="#confirmar" styleClass="boton" text="Confirmar reserva"/>
    <Label fx:id="etiquetaMensaje" styleClass="mensaje"/>
</VBox>