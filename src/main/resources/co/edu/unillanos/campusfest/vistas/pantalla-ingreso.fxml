<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" styleClass="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml">
    <stylesheets>
        <URL value="@estilo.css"/>
    </stylesheets>
    <Label styleClass="titulo" text="Registrar ingreso"/>
    <TextField fx:id="campoEventoId" promptText="Código del evento"/>
    <TextField fx:id="campoCodigoQr" promptText="Código QR de la reserva"/>
    <Button fx:id="botonRegistrar" onAction="#registrar" styleClass="boton" text="Registrar ingreso"/>
    <Label fx:id="etiquetaMensaje" styleClass="mensaje"/>
</VBox>