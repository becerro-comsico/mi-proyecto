<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" styleClass="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml">
    <stylesheets>
        <URL value="@estilo.css"/>
    </stylesheets>
    <Label styleClass="titulo" text="Editar evento"/>
    <TextField fx:id="campoEventoId" promptText="Código del evento"/>
    <Button fx:id="botonCargar" onAction="#cargar" styleClass="boton" text="Cargar evento"/>
    <TextField fx:id="campoNombre" promptText="Nombre"/>
    <TextField fx:id="campoFecha" promptText="Fecha y hora (2026-11-28T19:00)"/>
    <TextField fx:id="campoLugar" promptText="Lugar"/>
    <TextField fx:id="campoAforo" promptText="Aforo"/>
    <Button fx:id="botonGuardar" onAction="#guardar" styleClass="boton" text="Guardar cambios"/>
    <Label fx:id="etiquetaMensaje" styleClass="mensaje"/>
</VBox>